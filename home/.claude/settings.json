{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "command -v gh-axi >/dev/null 2>&1 || exit 0; gh-axi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "command -v chrome-devtools-axi >/dev/null 2>&1 || exit 0; chrome-devtools-axi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "command -v lavish-axi >/dev/null 2>&1 || exit 0; lavish-axi",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "find-skills": "off",
    "vercel-composition-patterns": "off",
    "vercel-optimize": "off",
    "vercel-react-best-practices": "off",
    "vercel-react-native-skills": "off",
    "vercel-react-view-transitions": "off",
    "web-design-guidelines": "off",
    "writing-guidelines": "off",
    "deploy-to-vercel": "off",
    "vercel-cli-with-tokens": "off"
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi",
    "type": "command"
  },
  "theme": "dark-ansi"
}
